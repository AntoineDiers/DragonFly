FROM ubuntu:24.04

# Install gcc, cmake and gcovr
RUN apt update && apt install -y build-essential cmake gcovr gcc-arm-none-eabi git

# Install picotool
RUN apt update && apt install -y libusb-1.0-0-dev
COPY assets/picotool-2.3.0-x86_64-lin/picotool/ /opt/picotool/
ENV picotool_DIR=/opt/picotool

# Install sphinx
COPY assets/install_sphinx.sh /tmp/install_sphinx.sh
RUN /tmp/install_sphinx.sh

# Install npm
RUN apt-get update && \
    apt-get install -y curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g @angular/cli

ENV NG_CLI_ANALYTICS=false
