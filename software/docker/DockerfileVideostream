FROM dtcooper/raspberrypi-os:bookworm

# Install rpicam-apps
COPY assets/install_rpi_cam_apps.sh /tmp/install_rpi_cam_apps.sh
RUN /tmp/install_rpi_cam_apps.sh

# Install Gstreamer
COPY assets/install_gst.sh /tmp/install_gst.sh
RUN /tmp/install_gst.sh
ENV GST_PLUGIN_PATH=/usr/lib/gst-plugins/

# Install entrypoint
COPY assets/entrypoints/videostream_entrypoint.sh /entrypoint.sh